<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Audio, AirPlay, and Picture in Picture" background mode. Required for
	     Picture-in-Picture; cannot be expressed as an INFOPLIST_KEY_* build
	     setting, so it lives in this partial plist. Xcode merges the generated
	     INFOPLIST_KEY_* values into these contents at build time. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
